# Nutrient Python SDK license key (detection). Empty = evaluation mode.
NUTRIENT_LICENSE_KEY=
# Nutrient Web SDK license key (Form Creator), sent to the browser. Empty = evaluation mode.
WEB_SDK_LICENSE_KEY=
# How fields are named: llm (captions and types by layout rules, names by the LLM), rules (no LLM),
# llm-only (the LLM decides captions, names and types), sdk-vlm (the SDK's own labeling with a vision model).
LABELS=llm
# OpenAI-compatible endpoint and model that name the fields (Ollama by default).
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# API key of that endpoint. Leave empty for Ollama.
LLM_API_KEY=
# Vision model for LABELS=sdk-vlm. VLM_BASE_URL and VLM_API_KEY default to the LLM values.
VLM_BASE_URL=
VLM_MODEL=qwen2.5vl:7b
VLM_API_KEY=
# Fields the SDK model finds with a lower confidence are dropped.
MIN_CONFIDENCE=0.5
# Flat forms, and where proposals, uploads and exported PDFs are written.
FORMS_FOLDER=samples/forms
OUTPUT_FOLDER=output
# Address of the review page.
HOST=127.0.0.1
PORT=4710
